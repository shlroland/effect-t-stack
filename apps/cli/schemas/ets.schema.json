{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/shlroland/effect-t-stack/main/apps/cli/schemas/ets.schema.json",
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Fingerprint schema version (not CLI semver)"
    },
    "runtime": {
      "type": "string"
    },
    "api": {
      "type": "string"
    },
    "database": {
      "type": "string"
    },
    "orm": {
      "type": "string"
    },
    "auth": {
      "type": "string"
    },
    "frontend": {
      "type": "string"
    },
    "backend": {
      "type": "string"
    },
    "addons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "name": {
      "type": "string"
    },
    "effect": {
      "type": "string"
    },
    "apiOptions": {
      "type": "object"
    },
    "ormOptions": {
      "type": "object"
    },
    "frontendOptions": {
      "type": "object"
    },
    "backendOptions": {
      "type": "object"
    },
    "env": {
      "type": "object"
    },
    "addonOptions": {
      "type": "object"
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "packageManager": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "description": "Create-time stamp written by the generator"
    },
    "cliVersion": {
      "type": "string",
      "description": "create-effect-t-stack release that wrote/updated this file"
    },
    "reproducibleCommand": {
      "type": "string",
      "description": "Command that produced or last updated this fingerprint"
    },
    "dbSetupOptions": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "alchemy",
            "auto",
            "manual"
          ]
        }
      },
      "allOf": [
        {
          "type": "object",
          "additionalProperties": {}
        }
      ]
    },
    "webDeploy": {
      "type": "string"
    },
    "serverDeploy": {
      "type": "string"
    },
    "$schema": {
      "type": "string",
      "description": "Optional JSON Schema URL for editor UX"
    }
  },
  "required": [
    "version",
    "runtime",
    "api",
    "database",
    "orm",
    "auth",
    "frontend",
    "backend",
    "addons"
  ],
  "allOf": [
    {
      "type": "object",
      "additionalProperties": {}
    }
  ],
  "title": "effect-t-stack fingerprint (ets.jsonc)",
  "description": "Stack fingerprint for create-effect-t-stack. version = schema version (not CLI release). See docs/fingerprint.md."
}
