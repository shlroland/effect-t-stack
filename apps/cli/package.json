{
  "name": "create-effect-t-stack",
  "version": "0.1.0",
  "description": "Scaffold an Effect v4 full-stack app from the effect-t-stack Golden Sample",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shlroland/effect-t-stack.git",
    "directory": "apps/cli"
  },
  "homepage": "https://github.com/shlroland/effect-t-stack#readme",
  "bugs": {
    "url": "https://github.com/shlroland/effect-t-stack/issues"
  },
  "keywords": [
    "effect",
    "bun",
    "scaffold",
    "create",
    "tanstack",
    "drizzle"
  ],
  "engines": {
    "bun": ">=1.4.4"
  },
  "bin": {
    "create-effect-t-stack": "./src/bin.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "README.md",
    "schemas",
    "src",
    "templates"
  ],
  "scripts": {
    "start": "bun run src/bin.ts",
    "pack:golden": "bun run scripts/pack-golden.ts",
    "prepack": "bun run pack:golden",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "assert:test-layout": "bun run scripts/assert-no-src-tests.ts",
    "test": "bun test test",
    "lint": "oxlint -c .oxlintrc.json -f unix src scripts test",
    "check": "bun run assert:test-layout && bun run lint && bun run check-types && bun run test"
  },
  "dependencies": {
    "@effect/platform-bun": "^4.1.3",
    "effect": "^4.1.4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxlint": "^1.93.0",
    "typescript": "^6.0.3"
  }
}
