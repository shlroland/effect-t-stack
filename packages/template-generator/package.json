{
  "name": "@effect-t-stack/template-generator",
  "version": "0.1.0",
  "private": true,
  "description": "Handlebars + in-memory VFS generator for create-effect-t-stack. First template is the Golden Sample default stack.",
  "type": "module",
  "engines": {
    "bun": ">=1.4.4"
  },
  "exports": {
    ".": "./src/index.ts",
    "./fs-writer": "./src/fs-writer.ts"
  },
  "scripts": {
    "prebuild": "bun run scripts/generate-templates.ts",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint -c .oxlintrc.json -f unix src scripts test",
    "test": "bun run prebuild && bun test ./test",
    "check": "bun run prebuild && bun run lint && bun run check-types && bun test ./test"
  },
  "dependencies": {
    "handlebars": "^4.7.8",
    "memfs": "^4.49.0"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/node": "^26.6.6",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  }
}
