# Secondary standalone Bun HttpApi server (primary path is TanStack Start — apps/web/.env).
PORT=3737
{{#if (eq database "postgres")}}
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/ets
{{else}}
DATABASE_URL=./data.db
{{/if}}
# Comma-separated browser origins allowed by CORS (Vite default ports)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
