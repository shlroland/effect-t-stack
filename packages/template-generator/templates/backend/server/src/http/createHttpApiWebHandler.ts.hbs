import { loadServerEnv, type MakeServerEnvProviderOptions } from "@{{projectName}}/config"
import { ApiPrefix } from "@{{projectName}}/protocol/http-api"
import { Layer } from "effect"
import { HttpMiddleware, HttpRouter, HttpServer } from "effect/http"
import { makeAppLive } from "../layers.ts"
import { HttpApiRoutes } from "./HttpApp.ts"

const withCors = HttpMiddleware.cors({
  allowedOrigins: ["http://localhost:5173", "http://127.0.0.1:5173"],
  allowedMethods: ["GET", "POST", "PATCH", "DELETE", "OPTIONS"],
  allowedHeaders: ["Content-Type"]
})

export type CreateHttpApiWebHandlerOptions = MakeServerEnvProviderOptions & {
  /** Enable CORS for cross-origin SPA clients (standalone Bun server). Same-origin Start mounts leave this off. */
  readonly cors?: boolean
  /** Share memoization with {@link createRpcWebHandler} when both are mounted. */
  readonly memoMap?: Layer.MemoMap
  /** Share AppLive with Rpc so both surfaces use one DB / Services graph. */
  readonly appLive?: ReturnType<typeof makeAppLive>
}

/**
 * WinterCG `fetch` handler for HttpApi under {@link ApiPrefix} (`/api`).
 */
export const createHttpApiWebHandler = (options?: CreateHttpApiWebHandlerOptions) => {
  const env = loadServerEnv(options)
  const appLive = options?.appLive ?? makeAppLive({
    databaseUrl: env.DATABASE_URL,
    port: env.PORT
  })
  const RoutesLive = HttpApiRoutes.pipe(
    Layer.provide(appLive),
    Layer.provide(HttpServer.layerServices)
  )

  return HttpRouter.toWebHandler(RoutesLive, {
    ...(options?.cors === true ? { middleware: withCors } : {}),
    ...(options?.memoMap !== undefined ? { memoMap: options.memoMap } : {})
  })
}

export const isHttpApiRequestPath = (pathname: string): boolean =>
  pathname === ApiPrefix || pathname.startsWith(`${ApiPrefix}/`)
