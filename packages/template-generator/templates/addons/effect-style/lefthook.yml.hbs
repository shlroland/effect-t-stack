# Git hooks for effect-style (dprint + oxlint). See ets.jsonc → addonOptions.effect-style.
pre-commit:
  parallel: true
  commands:
    oxlint:
      glob: "*.{ts,tsx,js,jsx}"
      run: {{pm.exec}} oxlint -c .oxlintrc.json --fix --deny-warnings {staged_files}
      stage_fixed: true
    dprint:
      glob: "*.{ts,tsx,js,jsx,json,md}"
      run: {{pm.exec}} dprint fmt {staged_files}
      stage_fixed: true
